# ==========================================
# CONFIGURAÇÕES DO BOT TELEGRAM SMM
# ==========================================
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA compartilhe o arquivo .env ou commite no Git!

# ==========================================
# TELEGRAM
# ==========================================
# Token do bot obtido via @BotFather no Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID do administrador (seu chat_id no Telegram)
# Use @userinfobot para descobrir seu ID
ADMIN_ID=123456789

# ==========================================
# API BARATOINSTA
# ==========================================
# Chave de API do painel BaratoInsta
API_KEY_BARATOINSTA=sua_chave_api_aqui

# ==========================================
# PAGAMENTO PIX
# ==========================================
# Sua chave PIX para recebimento
CHAVE_PIX=seuemail@exemplo.com

# Tipo da chave (email, cpf, telefone, aleatoria)
TIPO_CHAVE_PIX=email

# Nome que aparece no comprovante
NOME_BENEFICIARIO=Seu Nome Aqui

# ==========================================
# MARGENS DE LUCRO (OPCIONAL)
# ==========================================
# Margem fixa para preços abaixo de R$ 20
MARGEM_FIXA=4.00

# Margem percentual para preços entre R$ 20 e R$ 100 (0.25 = 25%)
MARGEM_PERCENTUAL_MEDIO=0.25

# Margem percentual para preços acima de R$ 100 (0.20 = 20%)
MARGEM_PERCENTUAL_ALTO=0.20

# ==========================================
# SEGURANÇA (OPCIONAL)
# ==========================================
# Máximo de tentativas de comprovante por pedido
MAX_TENTATIVAS_COMPROVANTE=3

# Máximo de pedidos por usuário por hora
MAX_PEDIDOS_POR_HORA=5

# Tempo de expiração do pedido em segundos (3600 = 1 hora)
TEMPO_EXPIRACAO_PEDIDO=3600

# Tolerância de valor no comprovante (em reais)
TOLERANCIA_VALOR=0.10

# ==========================================
# BANCO DE DADOS (OPCIONAL)
# ==========================================
# Caminho do arquivo SQLite
DATABASE_PATH=data/pedidos.db

# ==========================================
# LOGGING (OPCIONAL)
# ==========================================
# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Caminho do arquivo de log
LOG_FILE=data/bot.log

# ==========================================
# OCR (OPCIONAL)
# ==========================================
# Caminho do Tesseract (deixe vazio para usar o padrão)
TESSERACT_CMD=
